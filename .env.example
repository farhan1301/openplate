# Supabase → Project Settings → API (or `supabase projects api-keys`)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Optional: show "Continue with Google" (enable the Google provider in Supabase first)
VITE_ENABLE_GOOGLE_AUTH=false

# Optional: run on built-in sample data with no backend (for a public demo)
VITE_DEMO=false
